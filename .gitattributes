# 统一换行，避免 Windows/Linux 混合提交造成整文件 diff
* text=auto

*.py    text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# Windows 脚本保留 CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.wav   binary
*.mp4   binary
*.onnx  binary
*.bin   binary
